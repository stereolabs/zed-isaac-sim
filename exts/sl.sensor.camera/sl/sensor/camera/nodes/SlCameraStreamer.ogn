{
    "ZED_Camera": {
        "version": 5,
        "categories": {
            "Stereolabs": "Nodes used with the Stereolabs ZED SDK"
        },
        "description": "Streams ZED camera data to the ZED SDK",
        "language": "Python",
        "metadata": {
            "uiName": "ZED Camera Helper"
        },
        "inputs": {
            "execIn": {
                "type": "execution",
                "description": "Triggers execution",
                "default": 0,
                "metadata": {
                    "uiName": "ExecIn"
                }
            },
            "cameraPrim": {
                "type": "target",
                "description": "ZED Camera prim used to stream data.",
                "metadata": {
                    "uiName": "ZED Camera Prim",
                    "literalOnly": "1",
                    "allowMultiInputs": "0",
                    "uiGroup": "Camera Selection"
                }
            },
            "cameraModel": {
                "type": "token",
                "description": "ZED Camera model.",
                "default": "ZED_X",
                "metadata": {
                    "uiName": "Camera Model",
                    "allowedTokens": [
                        "ZED_X",
                        "ZED_XM",
                        "ZED_X_Nano",
                        "ZED_M",
                        "ZED_2i"
                    ],
                    "uiGroup": "Configuration"
                }
            },
            "lensType": {
                "type": "token",
                "description": "Lens fitted to the camera. Options shown depend on the selected camera model.",
                "default": "Wide",
                "metadata": {
                    "uiName": "Lens Type",
                    "allowedTokens": [
                        "Wide",
                        "Narrow"
                    ],
                    "uiGroup": "Configuration"
                }
            },
            "resolution": {
                "type": "token",
                "description": "Camera stream resolution.",
                "default": "SVGA",
                "metadata": {
                    "uiName": "Resolution",
                    "allowedTokens": [
                        "HD2K",
                        "HD1200",
                        "HD1080",
                        "HD720",
                        "SVGA",
                        "VGA"
                    ],
                    "uiGroup": "Configuration"
                }
            },
            "fps": {
                "type": "uint",
                "description": "Camera stream frame rate.",
                "default": 30,
                "metadata": {
                    "uiName": "FPS",
                    "uiGroup": "Configuration"
                }
            },
            "transportLayerMode": {
                "type": "token",
                "description": "Communication protocol used to send data to the ZED SDK. IPC improves streaming performance when streaming to the same machine (Linux and Windows)",
                "default": "BOTH",
                "metadata": {
                    "uiName": "Transport layer mode",
                    "allowedTokens": [
                        "BOTH",
                        "NETWORK",
                        "IPC"
                    ],
                    "uiGroup": "Streaming"
                }
            },
            "streamingPort": {
                "type": "uint",
                "description": "Unique port per camera.",
                "default": 30000,
                "metadata": {
                    "uiName": "Streaming Port",
                    "uiGroup": "Streaming"
                }
            },
            "bitrate": {
                "type": "uint",
                "description": "Bitrate in Kbps. (Used only if IPC is disabled)",
                "default": 8000,
                "metadata": {
                    "uiName": "Streaming Bitrate",
                    "uiGroup": "Streaming"
                }
            },
            "chunkSize": {
                "type": "uint",
                "description": "Chunk size in bytes. (Used only if IPC is disabled)",
                "default": 4096,
                "metadata": {
                    "uiName": "Streaming Chunk Size",
                    "uiGroup": "Streaming"
                }
            },
            "applyZedSim2Real": {
                "type": "bool",
                "default": true,
                "description": "Apply the ZED X camera model: the camera's auto exposure and auto white balance, sensor noise, motion blur, lens vignetting and sharpness, each with its own switch below. Off streams the render as is (the scene's own camera exposure, plain sRGB). Can be toggled live.",
                "metadata": {
                    "uiName": "Apply ZED Sim2Real",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "autoExposure": {
                "type": "bool",
                "default": true,
                "description": "Real-camera auto exposure: meters the rendered HDR image and drives the cameras' exposure time and gain (exposure:time / exposure:iso) like a real ZED X. Off keeps the scene's own camera exposure. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Auto exposure",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "autoWhiteBalance": {
                "type": "bool",
                "default": true,
                "description": "Real-camera auto white balance: estimates the light's colour from the rendered image and balances it like a real ZED X, including its limits (warm lights such as tungsten keep part of their orange cast). Off streams the render's own colours. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Auto white balance",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "sensorNoise": {
                "type": "bool",
                "default": true,
                "description": "Sensor noise of a real ZED X, following the camera's gain (exposure:iso): nearly clean in daylight, visible grain in dim scenes, snow at maximum gain in the dark. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Sensor noise",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "motionBlur": {
                "type": "bool",
                "default": true,
                "description": "Motion blur over each frame's exposure time, as on a real ZED X: sharp in daylight (sub-millisecond exposures), smeared indoors and in the dark (up to the full frame time). Follows the auto exposure, or the camera's exposure:time when it is off, per camera and per frame. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Motion blur",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "vignetting": {
                "type": "bool",
                "default": true,
                "description": "Lens vignetting of a real ZED X: the image darkens towards its edges. Scaled by field angle, so narrower lenses darken less; not applied to fisheye lenses. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Vignetting",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "cameraSharpness": {
                "type": "bool",
                "default": true,
                "description": "Sharpness of a real ZED X instead of the renderer's: the render is much crisper than the camera, which softens fine detail and sharpens edges with light halos. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Camera sharpness",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "streamDepth": {
                "type": "bool",
                "description": "Enable Left+Depth streaming mode instead of Left+Right. Uses ground-truth depth from Isaac Sim.",
                "default": false,
                "metadata": {
                    "uiName": "Stream Depth",
                    "uiGroup": "Streaming"
                }
            }
        }
    }
}
