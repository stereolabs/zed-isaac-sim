{
  "ZED_Depth": {
    "version": 2,
    "categories": {
      "Stereolabs": "Nodes used with Stereolabs ZED cameras"
    },
    "description": "SDK-free capture from a ZED camera using Isaac Sim's renderer: RGB images and optionally simulated stereo depth. Nothing is streamed and no ZED SDK is required.",
    "language": "Python",
    "metadata": {
      "uiName": "ZED Capture"
    },
    "inputs": {
      "execIn": {
        "type": "execution",
        "description": "Triggers execution",
        "default": 0,
        "metadata": {
          "uiName": "ExecIn"
        }
      },
      "cameraPrim": {
        "type": "target",
        "description": "ZED Camera prim (e.g. /World/ZED_X).",
        "metadata": {
          "uiName": "ZED Camera Prim",
          "literalOnly": "1",
          "allowMultiInputs": "0",
          "uiGroup": "Camera Selection"
        }
      },
      "cameraModel": {
        "type": "token",
        "description": "ZED Camera model. Determines intrinsics and stereo baseline.",
        "default": "ZED_X",
        "metadata": {
          "uiName": "Camera Model",
          "allowedTokens": ["ZED_X", "ZED_XM", "ZED_X_Nano", "ZED_M", "ZED_2i"],
          "uiGroup": "Configuration"
        }
      },
      "lensType": {
        "type": "token",
        "description": "Lens fitted to the camera. Options shown depend on the selected camera model.",
        "default": "Wide",
        "metadata": {
          "uiName": "Lens Type",
          "allowedTokens": ["Wide", "Narrow"],
          "uiGroup": "Configuration"
        }
      },
      "resolution": {
        "type": "token",
        "description": "Render resolution for RGB and depth.",
        "default": "SVGA",
        "metadata": {
          "uiName": "Resolution",
          "allowedTokens": ["HD2K", "HD1200", "HD1080", "HD720", "SVGA", "VGA"],
          "uiGroup": "Configuration"
        }
      },
      "enableSave": {
        "type": "bool",
        "description": "Save RGB (PNG) and depth (EXR) to disk each frame.",
        "default": false,
        "metadata": {
          "uiName": "Enable Save",
          "uiGroup": "Capture"
        }
      },
      "outputDir": {
        "type": "string",
        "description": "Directory to save frames. Required when Enable Save is on.",
        "default": "",
        "metadata": {
          "uiName": "Output Directory",
          "uiGroup": "Capture"
        }
      },
      "saveDepth": {
        "type": "bool",
        "description": "Write the depth map (EXR) alongside the RGB frames. Turn off to record images only: depth costs an extra render annotator and a float32 EXR per frame, which dominates capture I/O. Depth is a stereo feature and is unavailable on mono cameras.",
        "default": true,
        "metadata": {
          "uiName": "Save Depth",
          "uiGroup": "Capture"
        }
      }
    }
  }
}
