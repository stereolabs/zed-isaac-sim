{
    "ZED_Camera_One": {
        "version": 5,
        "categories": {
            "Stereolabs": "Nodes used with the Stereolabs ZED SDK"
        },
        "description": "Streams ZED mono camera data to the ZED SDK",
        "language": "Python",
        "metadata": {
            "uiName": "ZED Camera One Helper"
        },
        "inputs": {
            "execIn": {
                "type": "execution",
                "description": "Triggers execution",
                "default": 0,
                "metadata": {
                    "uiName": "ExecIn"
                }
            },
            "leftCameraPrim": {
                "type": "target",
                "description": "Main monocular camera",
                "metadata": {
                    "uiName": "Left Camera Prim",
                    "literalOnly": "1",
                    "allowMultiInputs": "0",
                    "uiGroup": "Camera Selection"
                }
            },
            "rightCameraPrim": {
                "type": "target",
                "description": "(optional) Used to create a virtual stereo camera from two ZED X Ones.",
                "metadata": {
                    "uiName": "Right Camera Prim (Optional)",
                    "literalOnly": "1",
                    "allowMultiInputs": "0",
                    "uiGroup": "Camera Selection"
                },
                "optional": true
            },
            "cameraModel": {
                "type": "token",
                "description": "ZED Mono Camera model.",
                "default": "ZED_XONE_GS",
                "metadata": {
                    "uiName": "Camera Model",
                    "allowedTokens": [
                        "ZED_XONE_UHD",
                        "ZED_XONE_GS",
                        "ZED_XONE_S"
                    ],
                    "uiGroup": "Configuration"
                }
            },
            "lensType": {
                "type": "token",
                "description": "Lens fitted to the camera. Options shown depend on the selected camera model.",
                "default": "Wide",
                "metadata": {
                    "uiName": "Lens Type",
                    "allowedTokens": [
                        "Wide",
                        "Narrow",
                        "Fisheye"
                    ],
                    "uiGroup": "Configuration"
                }
            },
            "transportLayerMode": {
                "type": "token",
                "description": "Communication protocol used to send data to the ZED SDK. IPC improves streaming performance when streaming to the same machine (Linux and Windows)",
                "default": "BOTH",
                "metadata": {
                    "uiName": "Transport layer mode",
                    "allowedTokens": [
                        "BOTH",
                        "NETWORK",
                        "IPC"
                    ],
                    "uiGroup": "Streaming"
                }
            },
            "resolution": {
                "type": "token",
                "description": "Camera stream resolution.",
                "default": "SVGA",
                "metadata": {
                    "allowedTokens": [
                        "HD4K",
                        "QHDPLUS",
                        "HD1200",
                        "HD1080",
                        "SVGA"
                    ],
                    "uiName": "Resolution",
                    "uiGroup": "Configuration"
                }
            },
            "cameraIndex": {
                "type": "int",
                "description": "Index of the camera among the simulated cameras of the same model and lens, from which the ZED SDK derives its serial number and calibration. -1 picks the first free index at Play. Used when the ZED camera mode is 'virtual' (the default).",
                "default": -1,
                "metadata": {
                    "uiName": "Camera Index",
                    "uiGroup": "Configuration"
                }
            },
            "fps": {
                "type": "uint",
                "description": "Camera stream frame rate.",
                "default": 30,
                "metadata": {
                    "uiName": "FPS",
                    "uiGroup": "Configuration"
                }
            },
            "serialNumber": {
                "type": "string",
                "description": "Serial number of the stereo cam. Only used for virtual ZED X cameras.",
                "default": "119999999",
                "metadata": {
                    "uiName": "Serial Number",
                    "uiGroup": "Configuration"
                }
            },
            "streamingPort": {
                "type": "uint",
                "description": "Even port to stream on. If another camera already uses it, Play changes it to the next free even port, with a warning.",
                "default": 30000,
                "metadata": {
                    "uiName": "Streaming Port",
                    "uiGroup": "Streaming"
                }
            },
            "bitrate": {
                "type": "uint",
                "description": "Streaming bitrate (Kbps).",
                "default": 8000,
                "metadata": {
                    "uiName": "Streaming Bitrate",
                    "uiGroup": "Streaming"
                }
            },
            "chunkSize": {
                "type": "uint",
                "description": "Streaming chunk size (bytes).",
                "default": 4096,
                "metadata": {
                    "uiName": "Streaming Chunk Size",
                    "uiGroup": "Streaming"
                }
            },
            "streamDepth": {
                "type": "bool",
                "description": "Enable Left+Depth streaming mode instead of Left+Right. Uses ground-truth depth from Isaac Sim.",
                "default": false,
                "metadata": {
                    "uiName": "Stream Depth",
                    "uiGroup": "Configuration"
                }
            },
            "applyZedSim2Real": {
                "type": "bool",
                "default": true,
                "description": "Apply the ZED X camera model: the camera's auto exposure and auto white balance, sensor noise, motion blur, lens vignetting, sharpness and focus blur, each with its own switch below. Off streams the render as is (the scene's own camera exposure, plain sRGB). Can be toggled live.",
                "metadata": {
                    "uiName": "Apply ZED Sim2Real",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "autoExposure": {
                "type": "bool",
                "default": true,
                "description": "Real-camera auto exposure: meters the rendered HDR image and drives the cameras' exposure time and gain (exposure:time / exposure:iso) like a real ZED X. Off keeps the scene's own camera exposure. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Auto exposure",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "autoWhiteBalance": {
                "type": "bool",
                "default": true,
                "description": "Real-camera auto white balance: estimates the light's colour from the rendered image and balances it like a real ZED X, including its limits (warm lights such as tungsten keep part of their orange cast). Off streams the render's own colours. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Auto white balance",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "sensorNoise": {
                "type": "bool",
                "default": true,
                "description": "Sensor noise of a real ZED X, following the camera's gain (exposure:iso): nearly clean in daylight, visible grain in dim scenes, snow at maximum gain in the dark. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Sensor noise",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "motionBlur": {
                "type": "bool",
                "default": true,
                "description": "Motion blur over each frame's exposure time, as on a real ZED X: sharp in daylight (sub-millisecond exposures), smeared indoors and in the dark (up to the full frame time). Follows the auto exposure, or the camera's exposure:time when it is off, per camera and per frame. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Motion blur",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "vignetting": {
                "type": "bool",
                "default": true,
                "description": "Lens vignetting of a real ZED X: the image darkens towards its edges. Scaled by field angle, so narrower lenses darken less; not applied to fisheye lenses. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Vignetting",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "cameraSharpness": {
                "type": "bool",
                "default": true,
                "description": "Sharpness of a real ZED X instead of the renderer's: the render is much crisper than the camera, which softens fine detail and sharpens edges with light halos. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Camera sharpness",
                    "uiGroup": "ZED Sim2Real"
                }
            },
            "focusBlur": {
                "type": "bool",
                "default": false,
                "description": "Fixed-focus blur (depth of field) of a real ZED X lens: the 2.2 mm is focused at 1.15 m (f/2.2), the 4 mm at 2 m (f/2.0); surfaces away from that distance, close ones most, are blurred by how far off they are. Renders each eye's depth while on (an extra render output per eye). ZED X, X Mini and X One GS / S lenses only. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real.",
                "metadata": {
                    "uiName": "Focus blur",
                    "uiGroup": "ZED Sim2Real"
                }
            }
        }
    }
}
