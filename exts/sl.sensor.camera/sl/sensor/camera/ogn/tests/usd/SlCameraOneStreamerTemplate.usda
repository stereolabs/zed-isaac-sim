#usda 1.0
(
    doc ="""Generated from node description file SlCameraOneStreamer.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_sl_sensor_camera_ZED_Camera_One" (
        docs="""Streams ZED mono camera data to the ZED SDK"""
    )
    {
        token node:type = "sl.sensor.camera.ZED_Camera_One"
        int node:typeVersion = 5

        # 20 attributes
        custom bool inputs:applyZedSim2Real = true (
            docs="""Apply the ZED X camera model: the camera's auto exposure and auto white balance, sensor noise, motion blur, lens vignetting and sharpness, each with its own switch below. Off streams the render as is (the scene's own camera exposure, plain sRGB). Can be toggled live."""
        )
        custom bool inputs:autoExposure = true (
            docs="""Real-camera auto exposure: meters the rendered HDR image and drives the cameras' exposure time and gain (exposure:time / exposure:iso) like a real ZED X. Off keeps the scene's own camera exposure. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real."""
        )
        custom bool inputs:autoWhiteBalance = true (
            docs="""Real-camera auto white balance: estimates the light's colour from the rendered image and balances it like a real ZED X, including its limits (warm lights such as tungsten keep part of their orange cast). Off streams the render's own colours. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real."""
        )
        custom uint inputs:bitrate = 8000 (
            docs="""Streaming bitrate (Kbps)."""
        )
        custom token inputs:cameraModel = "ZED_XONE_GS" (
            docs="""ZED Mono Camera model."""
        )
        custom bool inputs:cameraSharpness = true (
            docs="""Sharpness of a real ZED X instead of the renderer's: the render is much crisper than the camera, which softens fine detail and sharpens edges with light halos. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real."""
        )
        custom uint inputs:chunkSize = 4096 (
            docs="""Streaming chunk size (bytes)."""
        )
        custom uint inputs:execIn = 0 (
            docs="""Triggers execution"""
        )
        custom uint inputs:fps = 30 (
            docs="""Camera stream frame rate."""
        )
        custom rel inputs:leftCameraPrim (
            docs="""Main monocular camera"""
        )
        custom token inputs:lensType = "Wide" (
            docs="""Lens fitted to the camera. Options shown depend on the selected camera model."""
        )
        custom bool inputs:motionBlur = true (
            docs="""Motion blur over each frame's exposure time, as on a real ZED X: sharp in daylight (sub-millisecond exposures), smeared indoors and in the dark (up to the full frame time). Follows the auto exposure, or the camera's exposure:time when it is off, per camera and per frame. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real."""
        )
        custom token inputs:resolution = "SVGA" (
            docs="""Camera stream resolution."""
        )
        custom rel inputs:rightCameraPrim (
            docs="""(optional) Used to create a virtual stereo camera from two ZED X Ones."""
        )
        custom bool inputs:sensorNoise = true (
            docs="""Sensor noise of a real ZED X, following the camera's gain (exposure:iso): nearly clean in daylight, visible grain in dim scenes, snow at maximum gain in the dark. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real."""
        )
        custom string inputs:serialNumber = "119999999" (
            docs="""Serial number of the stereo cam. Only used for virtual ZED X cameras."""
        )
        custom bool inputs:streamDepth = false (
            docs="""Enable Left+Depth streaming mode instead of Left+Right. Uses ground-truth depth from Isaac Sim."""
        )
        custom uint inputs:streamingPort = 30000 (
            docs="""Unique port per camera."""
        )
        custom token inputs:transportLayerMode = "BOTH" (
            docs="""Communication protocol used to send data to the ZED SDK. IPC improves streaming performance when streaming to the same machine (Linux and Windows)"""
        )
        custom bool inputs:vignetting = true (
            docs="""Lens vignetting of a real ZED X: the image darkens towards its edges. Scaled by field angle, so narrower lenses darken less; not applied to fisheye lenses. Needs the sRGB stream. Can be toggled live. Needs Apply ZED Sim2Real."""
        )
    }
}
