        )
        custom quatd inputs:orientation = (1.0, 0.0, 0.0, 0.0) (
            docs="""IMU orientation at the frame's time (IJKR)"""
        )
        custom uint inputs:port = 5561 (
            docs="""Streaming port. Must be even: the stream also takes the next port up (RTP and RTCP)."""
        )
        custom string inputs:serialNumber = "109999999" (
            docs="""Serial number to stream as, for a virtual stereo pair (simCameraModel -1) or an SDK virtual camera (virtualCamera). Otherwise the node takes a serial number from the legacy pool and ignores this."""
