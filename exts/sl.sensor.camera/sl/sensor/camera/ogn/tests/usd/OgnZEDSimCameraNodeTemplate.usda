        custom uint64 inputs:dataPtrRight = 0 (
            docs="""CUDA device pointer to the right image (RGBA8)"""
        )
        custom uint inputs:depthHeight = 560 (
            docs="""Height of the streamed depth map in pixels (Left+Depth mode). Must match the depth buffer."""
        )
        custom uint inputs:depthWidth = 896 (
            docs="""Width of the streamed depth map in pixels (Left+Depth mode). Must match the depth buffer."""
        )
        custom uint inputs:execIn = 0 (
            docs="""Triggers execution"""
        )
        custom uint inputs:fps = 30 (
            docs="""Stream frame rate, in frames per second"""
        )
        custom uint inputs:height = 600 (
            docs="""Camera stream height in pixels."""
        )
        custom vector3d inputs:linearAcceleration = (0.0, 0.0, 0.0) (
