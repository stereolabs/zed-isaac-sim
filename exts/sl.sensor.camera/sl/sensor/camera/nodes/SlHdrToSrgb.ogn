{
    "ZED_HdrToSrgb": {
        "version": 1,
        "categories": {
            "Stereolabs": "Nodes used with Stereolabs ZED cameras"
        },
        "description": "Encodes a render product's linear HdrColor (float16 RGBA, on the GPU) into the sRGB RGBA8 image streamed by the ZED node, as a real ZED X outputs it: its sharpness, lens vignetting, motion blur over the exposure time, white balance and sensor noise. Inputs mirror the HdrColor annotator's pointer outputs; outputs mirror the rgb annotator's, so it slots in front of the ZED Stream node. The output buffer is complete when the node's exec fires.",
        "language": "Python",
        "metadata": {
            "uiName": "ZED HDR to sRGB",
            "hidden": "true"
        },
        "inputs": {
            "exec": {
                "type": "execution",
                "description": "Triggers the encode (connect the HdrColor annotator's exec)"
            },
            "dataPtr": {
                "type": "uint64",
                "description": "Device pointer to the HdrColor buffer (float16 RGBA)",
                "default": 0
            },
            "bufferSize": {
                "type": "uint64",
                "description": "Size of the HdrColor buffer in bytes",
                "default": 0
            },
            "width": {
                "type": "uint",
                "description": "Image width in pixels",
                "default": 0
            },
            "height": {
                "type": "uint",
                "description": "Image height in pixels",
                "default": 0
            },
            "strides": {
                "type": "int[2]",
                "description": "Byte strides of the HdrColor buffer: (pixel, row); zeros for contiguous",
                "default": [
                    0,
                    0
                ]
            },
            "cudaDeviceIndex": {
                "type": "int",
                "description": "CUDA device holding the buffer; negative means host memory (unsupported)",
                "default": -1
            },
            "noiseGain": {
                "type": "float",
                "default": 0.0,
                "description": "Total sensor gain (analog x digital, i.e. the camera's exposure:iso / 100) whose sensor noise is added before the encode; 0 or less adds no noise"
            },
            "noiseSeed": {
                "type": "uint",
                "default": 0,
                "description": "Decorrelates this encoder's noise from other encoders' (e.g. the other eye); the noise also changes every frame"
            },
            "eye": {
                "type": "uint",
                "default": 0,
                "description": "Which lens this encoder images: 0 left (or a single camera), 1 right"
            },
            "motionPtr": {
                "type": "uint64",
                "default": 0,
                "description": "Device pointer to the render product's MotionVectors buffer (float32 RGBA, pixels towards each pixel's previous position); 0 = no motion blur"
            },
            "motionSize": {
                "type": "uint64",
                "default": 0,
                "description": "Size of the MotionVectors buffer in bytes"
            },
            "blurScale": {
                "type": "float",
                "default": 0.0,
                "description": "Exposure time over the motion vectors' time step: the fraction of each vector the image is smeared along; 0 or less = no motion blur"
            },
            "vignetteInvFocal": {
                "type": "float",
                "default": 0.0,
                "description": "1 / the focal length in pixels at this resolution, for the lens vignetting; 0 or less = no vignetting"
            },
            "cameraMtf": {
                "type": "bool",
                "default": false,
                "description": "Apply a real ZED X's sharpness instead of the renderer's"
            },
            "whiteBalance": {
                "type": "float[3]",
                "default": [
                    1.0,
                    1.0,
                    1.0
                ],
                "description": "White balance gains (R, G, B) applied in linear light before the lens falloff and the noise, e.g. from the camera's auto white balance; (1, 1, 1) = none"
            }
        },
        "outputs": {
            "exec": {
                "type": "execution",
                "description": "Fires once the sRGB buffer is written"
            },
            "dataPtr": {
                "type": "uint64",
                "description": "Device pointer to the sRGB RGBA8 buffer"
            },
            "bufferSize": {
                "type": "uint64",
                "description": "Size of the sRGB buffer in bytes (width * height * 4)"
            },
            "width": {
                "type": "uint",
                "description": "Image width in pixels"
            },
            "height": {
                "type": "uint",
                "description": "Image height in pixels"
            },
            "cudaDeviceIndex": {
                "type": "int",
                "description": "CUDA device holding the output buffer"
            }
        }
    }
}
