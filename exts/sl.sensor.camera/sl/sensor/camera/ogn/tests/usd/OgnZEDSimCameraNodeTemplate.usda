            docs="""Size (in bytes) of the right image buffer: width * height * 4 (RGBA8), or the frame is skipped"""
        )
        custom uint inputs:chunkSize = 4096 (
            docs="""streaming chunk size (in bytes). Only used for network transport layer mode (not IPC)"""
        )
        custom uint64 inputs:cudaStreamLeft = 0 (
            docs="""CUDA stream the left image was written on, 0 if none: the node then copies the image on that stream and does not wait for the copy"""
