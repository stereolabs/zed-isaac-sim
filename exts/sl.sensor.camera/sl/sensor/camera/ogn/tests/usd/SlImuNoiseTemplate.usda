#usda 1.0
(
    doc ="""Generated from node description file SlImuNoise.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_sl_sensor_camera_ZED_ImuNoise" (
        docs="""Adds a real ZED X IMU's noise to an IMU reading before it is streamed: white accelerometer noise at the sensor's noise density and output rate (the ZED SDK's own IMU parameters for a ZED X) and a small accelerometer bias drawn once per run. Orientation noise is off by default. Pass-through when disabled."""
    )
    {
        token node:type = "sl.sensor.camera.ZED_ImuNoise"
        int node:typeVersion = 1

        # 8 attributes
        custom float inputs:accBias = 0.005 (
            docs="""Standard deviation of the per-run accelerometer bias, m/s^2 per axis"""
        )
        custom float inputs:accNoise = 0.019 (
            docs="""Accelerometer white noise per sample, m/s^2 (noise density x sqrt(output rate))"""
        )
        custom bool inputs:enabled = true (
            docs="""Add the noise; off passes the reading through unchanged"""
        )
        custom uint inputs:execIn (
            docs="""Triggers the node (connect the IMU reader's execOut)"""
        )
        custom vector3d inputs:linAcc = (0.0, 0.0, 0.0) (
            docs="""IMU linear acceleration, m/s^2"""
        )
        custom quatd inputs:orientation = (1.0, 0.0, 0.0, 0.0) (
            docs="""IMU orientation (IJKR)"""
        )
        custom float inputs:orientationNoise = 0.0 (
            docs="""Orientation jitter per sample, degrees; 0 = none"""
        )
        custom uint inputs:seed = 0 (
            docs="""Decorrelates this IMU's noise from other cameras'"""
        )

        # 3 attributes
        custom uint outputs:execOut (
            docs="""Fires once the outputs are written"""
        )
        custom vector3d outputs:linAcc (
            docs="""IMU linear acceleration with the noise and bias, m/s^2"""
        )
        custom quatd outputs:orientation (
            docs="""IMU orientation with the noise (IJKR)"""
        )
    }
}
