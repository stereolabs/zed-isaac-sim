        custom uint64 inputs:cudaStreamRight = 0 (
            docs="""CUDA stream the right image was written on, 0 if none"""
        )
        custom uint64 inputs:dataPtrDepth = 0 (
            docs="""Pointer to the depth data (cuda device pointer, float32)"""
