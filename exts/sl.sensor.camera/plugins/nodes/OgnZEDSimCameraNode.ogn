{
    "OgnZEDSimCameraNode": {
        "version": 3,
        "categories": [
            "function"
        ],
        "uiName": "ZED Stream",
        "metadata": {
            "hidden": "true"
        },
        "description": [
            "internal node used to stream images to the zed sdk"
        ],
        "inputs": {
            "execIn": {
                "type": "execution",
                "description": "Triggers execution",
                "default": 0,
                "metadata": {
                    "uiName": "ExecIn"
                }
            },
            "stream": {
                "type": "bool",
                "description": "Streams while true; while false each frame is skipped",
                "default": false
            },
            "transportLayerMode": {
                "type": "token",
                "description": "Communication protocol used to send data to the ZED SDK.",
                "default": "BOTH",
                "metadata": {
                    "uiName": "Transport layer mode",
                    "allowedTokens": [
                        "BOTH",
                        "NETWORK",
                        "IPC"
                    ]
                }
            },
            "bitrate": {
                "type": "uint",
                "description": "streaming bitrate (in Kbps). Only used for network transport layer mode (not IPC)",
                "default": 8000,
                "metadata": {
                    "uiName": "Streaming Bitrate"
                }
            },
            "chunkSize": {
                "type": "uint",
                "description": "streaming chunk size (in bytes). Only used for network transport layer mode (not IPC)",
                "default": 4096,
                "metadata": {
                    "uiName": "Streaming Chunk Size"
                }
            },
            "simCameraModel": {
                "type": "int",
                "description": "SDK MODEL code of the camera (as in SimCameraInfo::model). Set by the annotator via utils.get_sdk_model_id(); -1 selects the custom virtual-stereo path.",
                "default": 4
            },
            "simLensType": {
                "type": "int",
                "description": "Lens fitted to the camera, as SIM_LENS_TYPE: 0=Wide, 1=Narrow, 2=Fisheye. Set by the annotator via utils.get_sim_lens_type_id().",
                "default": 0
            },
            "width": {
                "type": "uint",
                "description": "Camera stream width in pixels.",
                "default": 960
            },
            "height": {
                "type": "uint",
                "description": "Camera stream height in pixels.",
                "default": 600
            },
            "fps": {
                "type": "uint",
                "description": "Stream frame rate, in frames per second",
                "default": 30
            },
            "port": {
                "type": "uint",
                "description": "Streaming port. Must be even: the stream also takes the next port up (RTP and RTCP).",
                "default": 5561,
                "metadata": {
                    "uiName": "Streaming Port"
                }
            },
            "serialNumber": {
                "type": "string",
                "description": "Serial number to stream as, for a virtual stereo pair (simCameraModel -1) or an SDK virtual camera (virtualCamera). Otherwise the node takes a serial number from the legacy pool and ignores this.",
                "default": "109999999"
            },
            "virtualCamera": {
                "type": "bool",
                "description": "serialNumber was built by the SDK's create_virtual_camera(): stream it as is instead of taking a serial from the legacy pool.",
                "default": false
            },
            "simulationTime": {
                "type": "double",
                "description": "Simulation time of the frame in seconds, which stamps it; 0 or less falls back to a steady clock started at the first frame without one"
            },
            "bufferSizeLeft": {
                "type": "uint64",
                "description": "Size (in bytes) of the left image buffer: width * height * 4 (RGBA8), or the frame is skipped"
            },
            "bufferSizeRight": {
                "type": "uint64",
                "description": "Size (in bytes) of the right image buffer: width * height * 4 (RGBA8), or the frame is skipped"
            },
            "bufferSizeDepth": {
                "type": "uint64",
                "description": "Size (in bytes) of the depth buffer"
            },
            "dataPtrLeft": {
                "type": "uint64",
                "description": "CUDA device pointer to the left image (RGBA8)",
                "default": 0
            },
            "dataPtrRight": {
                "type": "uint64",
                "description": "CUDA device pointer to the right image (RGBA8)",
                "default": 0
            },
            "dataPtrDepth": {
                "type": "uint64",
                "description": "Pointer to the depth data (cuda device pointer, float32)",
                "default": 0
            },
            "cudaStreamLeft": {
                "type": "uint64",
                "description": "CUDA stream the left image was written on, 0 if none: the node then copies the image on that stream and does not wait for the copy",
                "default": 0
            },
            "cudaStreamRight": {
                "type": "uint64",
                "description": "CUDA stream the right image was written on, 0 if none",
                "default": 0
            },
            "streamDepth": {
                "type": "bool",
                "description": "Enable Left+Depth streaming mode instead of Left+Right",
                "default": false
            },
            "depthWidth": {
                "type": "uint",
                "description": "Width of the streamed depth map in pixels (Left+Depth mode). Must match the depth buffer.",
                "default": 896
            },
            "depthHeight": {
                "type": "uint",
                "description": "Height of the streamed depth map in pixels (Left+Depth mode). Must match the depth buffer.",
                "default": 560
            },
            "orientation": {
                "type": "quatd[4]",
                "description": "IMU orientation at the frame's time (IJKR)",
                "default": [
                    0.0,
                    0.0,
                    0.0,
                    1.0
                ]
            },
            "linearAcceleration": {
                "type": "vectord[3]",
                "description": "IMU linear acceleration at the frame's time, m/s^2",
                "default": [
                    0.0,
                    0.0,
                    0.0
                ]
            }
        },
        "outputs": {
            "streamerId": {
                "type": "int",
                "default": -1,
                "description": "Id of this camera's streamer in the ZED SDK, -1 while it is not open. The camera's auto exposure uses it to apply the camera settings stream receivers set.",
                "metadata": {
                    "uiName": "Streamer id",
                    "hidden": "true"
                }
            }
        }
    }
}
